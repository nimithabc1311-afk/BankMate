<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BANKMATE"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="15dp" />

    <TextView
        android:id="@+id/tvCustomerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Customer Name: Nimitha"
        android:textSize="18sp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvAccountNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Account Number: 1234567890"
        android:textSize="18sp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available Balance: ₹50,000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Service"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingTop="20dp"
        android:paddingBottom="10dp" />

    <Button
        android:id="@+id/btnAccountDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Account Details" />

    <Button
        android:id="@+id/btnFundTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fund Transfer" />

    <Button
        android:id="@+id/btnTransactionHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transaction History" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp" />

</LinearLayout>